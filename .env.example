# Copy to .env and fill in. Never commit .env.

# Google Gemini (AI Studio, free tier): LLM + embeddings (D7, D9)
GEMINI_API_KEY="<your_gemini_api_key>"

# Tavily: web research
TAVILY_API_KEY="<your_tavily_api_key>"

# Supabase: Postgres + pgvector (knowledge base, briefings, run logs, demo counter)
SUPABASE_URL="https://<your_project_ref>.supabase.co"

SUPABASE_KEY="<your_supabase_key>"
SUPABASE_ANON_KEY="<your_supabase_anon_key>"

# Optional RAG settings (defaults shown)
# EMBEDDING_MODEL="gemini-embedding-001"
# EMBEDDING_DIM=1536
# CHUNKING_STRATEGY="markdown"   # or "fixed" (baseline, uses CHUNK_SIZE / CHUNK_OVERLAP)
# CHUNK_SIZE=500
# CHUNK_OVERLAP=50

# Optional agent settings (defaults shown)
# CHAT_MODEL="gemini-3.5-flash"
# CHAT_MODEL_SMALL="gemini-3.5-flash-lite"
# RESEARCH_MODEL_TIER=small      # Research Agent model: small (default, saves the strong model's daily quota) | strong
# NEWS_MAX_RESULTS=5
# AGENT_MAX_MODEL_CALLS=6

# Optional KB management + job worker settings (defaults shown, D35)
# KB_MAX_UPLOAD_MB=20
# KB_MAX_CHUNKS=500
# WORKER_ENABLED=true            # run the job worker inside the API process
# INGEST_CONCURRENCY=1

# Optional external research settings (Phase 3, D37)
# RESEARCH_DEPTH=standard        # quick | standard | in_depth (default for the agent tools)
# TAVILY_CACHE_DIR=              # eval/tests only: cache Tavily responses here so re-runs cost no credits

# Demo mode (Phase 6, D39 §2). On unless DEMO_MODE=off (fail closed): live runs need the access code
# and a free slot in the site-wide daily cap (counted in Supabase, resets at midnight Pacific = 10:00 Israel).
# Locally set DEMO_MODE=off to run without a code. On Streamlit Cloud set these in Secrets.
# DEMO_MODE=on
# DEMO_ACCESS_CODE=""            # no code configured + demo mode on = live runs disabled
# DEMO_DAILY_CAP=4               # each run uses ~2 strong-model calls (free tier: 20 per day)
